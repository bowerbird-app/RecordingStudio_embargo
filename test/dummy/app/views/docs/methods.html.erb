<% dummy_page_nav(
  title: "Methods",
  subtitle: "Document the public methods your addon exposes.",
  back_url: root_path
) %>

<div class="flex w-full flex-col gap-6">

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Editor link",
    subtitle: "recording_studio_embargo_management_path",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Link the recording the host already has. return_to comes back after a full-page save.
      recording_studio_embargo_management_path(page_recording, return_to: request.fullpath)

      # True while a hold is on and the release time is still ahead.
      embargoed?(page_recording)
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    Provide one section title and codeblock for each method
  </p>
</div>
