<% dummy_page_nav(title: "Embargo", back_url: root_path) %>
<% turbo_refreshes_with(method: :morph, scroll: :preserve) if respond_to?(:turbo_refreshes_with) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Embargo",
    subtitle: "Hold a page until a release time, and optionally let people with access through early.",
    variant: :h1
  ) %>

  <% if @page_recording %>
    <%= turbo_stream_from @page_recording %>

    <div id="embargo-notices" class="flex flex-col items-start gap-3">
      <%= render_embargo_notice(@page_recording, id: "embargo-notice-md", class: "embargo-notice") %>
      <%= render_embargo_notice(@page_recording, size: :sm, id: "embargo-notice-sm", class: "embargo-notice") %>
    </div>

    <% management_path = recording_studio_embargo_management_path(
      @page_recording,
      return_to: root_path(recording_id: @page_recording.id)
    ) %>
    <% menu_label = embargoed?(@page_recording) ? "Embargoed" : "Embargo" %>

    <%= render FlatPack::Modal::Component.new(id: "embargo-editor-modal", size: :xl) do |modal| %>
      <% modal.body do %>
        <%= turbo_frame_tag "embargo_editor" %>
      <% end %>
    <% end %>

    <div id="embargo-host-actions">
      <%= render FlatPack::Button::Dropdown::Component.new(text: "More", id: "embargo-more-menu", style: :secondary) do |dropdown| %>
        <% if embargoed?(@page_recording) %>
          <% dropdown.menu_item(
            text: menu_label,
            icon: "lock",
            href: management_path,
            id: "embargo-menu-item",
            data: { modal_id: "embargo-editor-modal", turbo_frame: "embargo_editor" }
          ) %>
        <% else %>
          <% dropdown.menu_item(
            text: menu_label,
            href: management_path,
            id: "embargo-menu-item",
            data: { modal_id: "embargo-editor-modal", turbo_frame: "embargo_editor" }
          ) %>
        <% end %>
      <% end %>

      <%= render FlatPack::Button::Component.new(
        text: "Open embargo page",
        style: :ghost,
        size: :md,
        href: management_path,
        id: "embargo-full-page-link"
      ) %>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What's working",
          subtitle: "Embargo behavior already wired into the dummy app.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>The editor holds a page private until a release date.</li>
          <li>Early access lets people who already have access see it before the release date. Everyone else has to wait.</li>
          <li>Expiry is read when the request is authorized.</li>
          <li>The dummy app exercises authentication, the Recording Studio default layout, and FlatPack.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Host setup",
          subtitle: "What a host app does after adding the gem.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li>Mount the engine and run the install generator.</li>
          <li>Copy the embargo migration into the host and migrate.</li>
          <li>Opt a recordable in with <code>RecordingStudio::Capabilities::Embargo.to</code>.</li>
          <li>Configure the same actions on Accessible, including view and download separately.</li>
        </ol>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "FlatPack usage",
          subtitle: "This page uses FlatPack components for its primary UI structure.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Use FlatPack cards, buttons, badges, inputs, and layout primitives as the default path for addon UI. Keep raw HTML for simple semantic content only.
        </p>
      <% end %>

      <% card.footer do %>
        <a href="https://github.com/bowerbird-app/flatpack"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex">
          <%= render FlatPack::Button::Component.new(
            text: "View FlatPack documentation",
            style: :primary,
            size: :md
          ) %>
        </a>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Install flow",
          subtitle: "What the host app generator path covers.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Add the gem to your host app and run <code>bundle install</code>.</li>
          <li>Run <code>rails generate recording_studio_embargo:install</code> to mount the engine and add configuration.</li>
          <li>Run <code>rails generate recording_studio_embargo:migrations</code> to copy engine migrations into the host app.</li>
          <li>Rebuild Tailwind if needed with <code>bin/rails tailwindcss:build</code>.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
