<% frame_request = respond_to?(:turbo_frame_request?) && turbo_frame_request? %>
<% if respond_to?(:recording_studio_page_nav) && !frame_request %>
  <% recording_studio_page_nav(
    title: t("recording_studio_embargo.editor.title"),
    page_nav_back_url: @return_to.presence || main_app.root_path,
    page_nav_back_label: @return_to.present? ? "Back" : "Home"
  ) %>
<% end %>

<% if frame_request %>
  <%= turbo_frame_tag turbo_frame_request_id do %>
    <%= render "editor" %>
  <% end %>
<% else %>
  <%= render "editor" %>
<% end %>
