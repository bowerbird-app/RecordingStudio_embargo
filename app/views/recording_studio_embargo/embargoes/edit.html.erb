<% frame_request = respond_to?(:turbo_frame_request?) && turbo_frame_request? %>
<% unless frame_request %>
  <% content_for :title, t("recording_studio_embargo.editor.title") %>
  <% content_for :subtitle, t("recording_studio_embargo.editor.subtitle") %>
  <% flat_pack_page_nav(
       round: true,
       style: :default,
       back_href: @return_to.presence || main_app.root_path,
       back_tooltip: @return_to.present? ? "Back" : "Home"
     ) %>
<% end %>

<% if frame_request %>
  <%= turbo_frame_tag turbo_frame_request_id do %>
    <%= render "editor" %>
  <% end %>
<% else %>
  <%= render "editor" %>
<% end %>
